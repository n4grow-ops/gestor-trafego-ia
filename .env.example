# Banco (serviço postgres do Easypanel)
DATABASE_URL=postgres://postgres:SENHA@gestor-trafego-ia_postgres:5432/gestor?sslmode=disable

# API
HTTP_ADDR=:8080
WEBHOOK_SECRET=gere-um-valor-aleatorio-longo

# OpenRouter (conferir IDs em https://openrouter.ai/models)
OPENROUTER_API_KEY=
ATTENDANT_MODEL=google/gemini-2.5-flash
MANAGER_MODEL=anthropic/claude-sonnet-5
TRANSCRIBE_MODEL=google/gemini-2.5-flash

# WAHA (rede interna do Easypanel), motor GOWS
WAHA_URL=http://gestor-trafego-ia_waha:3000
WAHA_API_KEY=gere-outro-valor-aleatorio
WAHA_SESSION=default

# Quem recebe aviso de atendimento humano. Use o número exatamente como está no WhatsApp
# (celulares antigos podem estar registrados sem o nono dígito; confira no primeiro aviso).
OPERATOR_PHONE=5511999998888

# Cadastro automático de número novo (etapa 2) e limites iniciais do cliente
AUTO_SIGNUP=true
AUTO_SIGNUP_MAX_BUDGET=50
AUTO_SIGNUP_DAILY_LIMIT=60

# Atendente humana: visto, "digitando…", balões, respostas juntas e voz
HUMANIZE=true
REPLY_DEBOUNCE_SECONDS=4
VOICE_REPLIES=true
# Modelo de TTS do OpenRouter (https://openrouter.ai/collections/text-to-speech-models), com saída MP3.
# Vazio = responde só em texto. Validado em 2026-09-23: microsoft/mai-voice-2-flash + pt-BR-FranciscaNeural.
# (Gemini TTS não serve: só entrega PCM.)
TTS_MODEL=microsoft/mai-voice-2-flash
TTS_VOICE=pt-BR-FranciscaNeural

# Cadastro do cliente (api e worker). Sem PUBLIC_BASE_URL + SUPABASE_*, ninguém é barrado pelo cadastro.
# Enquanto não houver subdomínio próprio, use o domínio da api no Easypanel.
PUBLIC_BASE_URL=https://cadastro.seudominio.com.br
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Número do WhatsApp do atendimento (botão "Voltar para o WhatsApp"), só na api.
BOT_WHATSAPP_NUMBER=5511999998888

# Etapa dos anúncios (imagens e vídeos) no Supabase Storage — só no worker. Chave service_role: segredo!
SUPABASE_SERVICE_ROLE_KEY=
# Relatório diário às 8 h (padrão: OPERATOR_PHONE). Vazio = sem relatório.
REPORT_PHONE=
